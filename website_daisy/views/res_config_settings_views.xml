<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_daisy" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.daisy</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Daisy Theme" string="Daisy Theme" name="website_daisy">
                    <block title="Theme Aesthetics &amp; Appearance" id="daisy_theme_block">
                        <setting id="daisy_scheme_setting" string="Appearance Color Scheme" help="Transform the entire web client into Studio Light or Midnight OLED Dark">
                            <field name="daisy_color_scheme"/>
                        </setting>
                        <setting id="daisy_color_setting" string="Brand Accent &amp; Gradient" help="Select the rich gradient and radiant accent applied to primary buttons, active navigation, focus rings, and badges">
                            <field name="daisy_theme_color"/>
                        </setting>
                        <setting id="daisy_card_setting" string="Card &amp; Surface Elevation" help="Controls card depth, floating multi-layer shadows, or glassmorphic blur across form sheets and kanban">
                            <field name="daisy_card_style"/>
                        </setting>
                        <setting id="daisy_radius_setting" string="UI Corner Radius" help="Controls the roundness across all cards, input boxes, buttons, and popovers">
                            <field name="daisy_border_radius"/>
                        </setting>
                        <setting id="daisy_font_setting" string="Typography &amp; Fonts" help="Choose the primary typeface applied across the ERP web client">
                            <field name="daisy_font_family"/>
                        </setting>
                        <setting id="daisy_sidebar_setting" string="Application Drawer Style" help="Choose between the spacious 320px modern drawer or compact menu">
                            <field name="daisy_sidebar_style"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
