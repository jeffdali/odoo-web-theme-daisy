<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- Daisy Theme: Enhanced Apps Sidebar Menu with Module Icons, Active Links & Width -->
  <t t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('o_navbar_apps_menu')]//t[@t-set-slot='content']" position="replace">
      <t t-set-slot="content">
        <div class="o_apps_sidebar_header d-flex align-items-center justify-content-between px-3 py-2 mb-1 border-bottom">
          <span class="text-uppercase fw-bold text-muted small" style="font-size: 0.7rem; letter-spacing: 0.05em;">Applications</span>
          <span class="badge bg-light text-muted border rounded-pill" style="font-size: 0.7rem;" t-esc="apps.length"/>
        </div>
        <div class="o_apps_sidebar_list">
          <DropdownItem
            t-foreach="apps"
            t-as="app"
            t-key="app.id"
            class="{ 'o_app': true, 'active': menuService.getCurrentApp() === app, 'o_app_active': menuService.getCurrentApp() === app, focus: menuService.getCurrentApp() === app }"
            onSelected="() => this.onNavBarDropdownItemSelection(app)"
            attrs="{ href: getMenuItemHref(app), 'data-menu-xmlid': app.xmlid, 'data-section': app.id }"
          >
            <div class="o_app_item_content d-flex align-items-center w-100 py-1">
              <div class="o_app_icon_wrapper me-3 flex-shrink-0 d-flex align-items-center justify-content-center">
                <img t-if="app.webIconData" class="o_app_icon" t-attf-src="{{app.webIconData}}" alt="" />
                <span t-else="" class="o_app_fallback_letter"><t t-esc="app.name[0]" /></span>
              </div>
              <span class="o_app_name flex-grow-1 text-truncate" t-esc="app.name"/>
            </div>
          </DropdownItem>
        </div>
      </t>
    </xpath>
  </t>

</templates>
